# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a hardware profile instead of detecting one.
# One of: cuda_large, cuda_small, mps, cpu
# BILINGUAL_RAG_PROFILE=cpu

# Optional: point at a non-default Qdrant.
# QDRANT_URL=http://localhost:6333
